PORT=3000
NODE_ENV=development

#CORS (comma-separatedorigins)
CORS_ORIGIN=http://localhost:8080

#Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_NAME=nest_starter_db

#Redis Cache &Sessions
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

#Docker host ports (defaults used by infrastructure/docker/development)
NGINX_HTTP_PORT=8080
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
ALERTMANAGER_DISCORD_PORT=8081
NATS_PORT=4222
NATS_MONITOR_PORT=8222
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# JWT Auth (dev-onlysecret)
JWT_SECRET=dev_jwt_secret_change_me

# OAuth (Google) — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
FRONTEND_URL="http://localhost:3000"

#Optional:Notifications(Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

#Optional:Alertmanager/Discord
ALERTMANAGER_URL=http://alertmanager:9093
ALERT_WEBHOOK_URL=http://alertmanager-discord:8080/webhook
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_id/your_webhook_token
DISCORD_USERNAME=nest-starter-alerts
