# Server 
PORT=3000
NODE_ENV=production

# CORS (comma-separated origins) 
CORS_ORIGIN=https://api.example.com

# Nginx 
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Database (PostgreSQL) 
DB_HOST=127.0.0.1
DB_PORT=5435
POSTGRES_USER=nest_starter
# REQUIRED — replace before deploy: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_base64_32
DB_NAME=nest_starter_prod

# Redis Cache & Sessions 
REDIS_HOST=127.0.0.1
REDIS_PORT=6381

# Monitoring (loopback-only on the host)
PROMETHEUS_PORT=9092
ALERTMANAGER_PORT=9095
ALERTMANAGER_DISCORD_PORT=8084

# JWT Auth (REQUIRED — replace: openssl rand -hex 32) 
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# OAuth (Google) — REQUIRED for real logins: replace both values
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
FRONTEND_URL="http://localhost:3000"

# RabbitMQ Message Broker (REQUIRED — replace password: openssl rand -hex 16) 
RABBITMQ_USER=nest_starter
RABBITMQ_PASSWORD=REPLACE_WITH_openssl_rand_hex_16

# Optional: Notifications (Email) 
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: Alertmanager / Discord 
ALERTMANAGER_URL=http://alertmanager:9093
ALERT_WEBHOOK_URL=http://alertmanager-discord:8080/webhook
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_id/your_webhook_token
DISCORD_USERNAME=nest-starter-alerts
