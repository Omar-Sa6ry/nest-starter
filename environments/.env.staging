# Server
PORT=3000
NODE_ENV=staging

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:8082

# Nginx (staging entrypoint)
NGINX_HTTP_PORT=8082

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5436
POSTGRES_USER=nest_starter
POSTGRES_PASSWORD=nest_starter_staging
DB_NAME=nest_starter_staging

# Redis Cache & Sessions
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# JWT Auth (REPLACE before sharing this environment: openssl rand -hex 32)
JWT_SECRET=staging_jwt_secret_change_me

# OAuth (Google) — REQUIRED for real logins: replace both values
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
FRONTEND_URL="http://localhost:3000"

# Monitoring (loopback-only on the host)
PROMETHEUS_PORT=9091
ALERTMANAGER_PORT=9094
ALERTMANAGER_DISCORD_PORT=8083

# NATS Message Broker
NATS_PORT=4223
NATS_MONITOR_PORT=8223

# RabbitMQ Message Broker
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Optional: Alertmanager / Discord
ALERTMANAGER_URL=http://alertmanager:9093
ALERT_WEBHOOK_URL=http://alertmanager-discord:8080/webhook
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_id/your_webhook_token
DISCORD_USERNAME=nest-starter-alerts

# Payment Providers Configuration

# Fawry Pay Configuration
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
FAWRY_BASE_URL=https://atfawry.fawrystaging.com

# Stripe Configuration (Put your Stripe test key here)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key_placeholder
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_secret

# Paymob Configuration (Put your Paymob test keys here)
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=

# PayPal Configuration (Put your PayPal sandbox credentials here)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Realtime (WebSocket)
REALTIME_STORE=redis
REALTIME_CLUSTER=false
REALTIME_HEARTBEAT_STALE_MS=60000
REALTIME_HEARTBEAT_SWEEP_MS=30000
REALTIME_RATE_LIMIT_MAX=30
REALTIME_RATE_LIMIT_WINDOW_MS=10000

# Notifications
NOTIFICATION_RATE_LIMIT_WINDOW_MS=60000
NOTIFICATION_RATE_LIMIT_MAX=10

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_SECURE=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_SENDER=noreply@yourdomain.com
EMAIL_PROVIDER=nodemailer
SENDGRID_API_KEY=your_sendgrid_api_key

AWS_SES_ACCESS_KEY_ID=your_aws_ses_access_key
AWS_SES_SECRET_ACCESS_KEY=your_aws_ses_secret_key
AWS_SES_REGION=us-east-1

# Twilio Configuration
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=00000000000000000000000000000000
TWILIO_FROM_NUMBER=+10000000000
TWILIO_WHATSAPP_NUMBER=whatsapp:+10000000000
TWILIO_SMS_NUMBER=+10000000000

# SMS Misr Settings
SMSMISR_USERNAME=your_smsmisr_username
SMSMISR_PASSWORD=your_smsmisr_password
SMSMISR_SENDER=your_smsmisr_sender
SMS_PROVIDER=smsmisr
SMSMISR_ENVIRONMENT=2

# Vonage Nexmo Settings
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_SENDER=APPROVED_SENDER_ID

# Telegram Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ENABLE_TELEGRAM_BOT=false

# Discord
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_discord_webhook_id/your_discord_webhook_token

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_DEFAULT_CHANNEL=#general

# OneSignal Configuration
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# Web Push VAPID Configuration
WEB_PUSH_PUBLIC_KEY=your_web_push_public_key
WEB_PUSH_PRIVATE_KEY=your_web_push_private_key
WEB_PUSH_SUBJECT=mailto:admin@yourdomain.com

# Teams and webhook
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/your_teams_webhook

# Generic Webhook Configuration
# WEBHOOK_DEFAULT_SIGNING_SECRET=your_signing_secret

