# Server
PORT=3000
NODE_ENV=staging

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:8082

# Nginx (staging entrypoint)
NGINX_HTTP_PORT=8082

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5436
POSTGRES_USER=nest_starter
POSTGRES_PASSWORD=nest_starter_staging
DB_NAME=nest_starter_staging

# Redis Cache & Sessions
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# JWT Auth (REPLACE before sharing this environment: openssl rand -hex 32)
JWT_SECRET=staging_jwt_secret_change_me

# OAuth (Google) — REQUIRED for real logins: replace both values
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
FRONTEND_URL="http://localhost:3000"

# Monitoring (loopback-only on the host)
PROMETHEUS_PORT=9091
ALERTMANAGER_PORT=9094
ALERTMANAGER_DISCORD_PORT=8083

# NATS Message Broker
NATS_PORT=4223
NATS_MONITOR_PORT=8223

# RabbitMQ Message Broker
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Optional: Notifications (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: Alertmanager / Discord
ALERTMANAGER_URL=http://alertmanager:9093
ALERT_WEBHOOK_URL=http://alertmanager-discord:8080/webhook
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_id/your_webhook_token
DISCORD_USERNAME=nest-starter-alerts

# Realtime (WebSocket)
REALTIME_STORE=redis #Or Memory
REALTIME_CLUSTER=false
REALTIME_HEARTBEAT_STALE_MS=60000
REALTIME_HEARTBEAT_SWEEP_MS=30000
REALTIME_RATE_LIMIT_MAX=30
REALTIME_RATE_LIMIT_WINDOW_MS=10000
