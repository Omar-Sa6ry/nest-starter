{
  "name": "@bts-soft/nest-starter",
  "version": "0.0.1",
  "description": "Production-ready NestJS 12 starter template: GraphQL (Apollo, code-first), TypeORM + PostgreSQL, Redis cache and sessions, JWT auth with refresh-token rotation and blacklisting, RBAC, Google OAuth 2.0, sliding-window rate limiting, i18n (en/ar), structured logging with trace IDs, Prometheus metrics, health probes, and isolated Docker Compose stacks for development, test, staging and production.",
  "private": true,
  "license": "Apache-2.0",
  "author": "Omar Ahmed Sabry",
  "keywords": [
    "nestjs",
    "starter",
    "template",
    "boilerplate",
    "graphql",
    "apollo",
    "typeorm",
    "postgresql",
    "redis",
    "jwt",
    "rbac",
    "oauth",
    "google-oauth",
    "rate-limiting",
    "i18n",
    "prometheus",
    "docker",
    "vitest",
    "typescript",
    "esm"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "make docker-test-up && vitest run --config ./vitest.config.e2e.ts && make docker-test-down",
    "clean": "node -e \"const fs=require('fs');for(const p of ['dist','coverage','tsconfig.build.tsbuildinfo'])fs.rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@bts-soft/cache": "^1.2.0",
    "@bts-soft/common": "^1.6.0",
    "@bts-soft/core": "^3.2.8",
    "@bts-soft/notifications": "^2.1.4",
    "@bts-soft/upload": "file:../../BTS Software/packages/upload",
    "@bts-soft/validation": "^1.3.0",
    "@nestjs/apollo": "^14.1.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/graphql": "^14.1.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.3.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.5.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "graphql": "^17.0.2",
    "graphql-upload-minimal": "^1.6.4",
    "nestjs-i18n": "^10.8.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.90.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
